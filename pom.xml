<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   Sunrise Dental Clinic Management System
   CIS6003 - Advanced Programming - WRIT1
  ============================================================================
   Aggregator / parent POM.

   The solution is deliberately split into THREE Maven modules so that the
   physical project structure mirrors the logical 3-tier + distributed
   architecture required by Task B:

     dental-common  -> shared contract (DTOs / enums). Depended upon by BOTH
                       the server and the remote client, which is what makes
                       the two processes able to talk without sharing code.
     dental-server  -> Presentation (Thymeleaf MVC + REST), Business (services,
                       design patterns) and Data (JPA/Flyway/H2/MySQL) tiers.
     dental-client  -> A physically separate, menu-driven Swing desktop
                       application that reaches the server ONLY over HTTP web
                       services. This is the proof of "distributed application".

   Java baseline is 17 (not 21) on purpose: it is the lowest LTS supported by
   Spring Boot 3.5.x, so the project compiles on any JDK from 17 upwards and
   will build on a marker's machine regardless of which JDK they have.
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>lk.icbt.cis6003</groupId>
    <artifactId>sunrise-dental-clinic</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Sunrise Dental Clinic Management System</name>
    <description>
        Distributed appointment and patient management system for Sunrise Dental Clinic, Colombo.
        CIS6003 Advanced Programming - WRIT1.
    </description>

    <modules>
        <module>dental-common</module>
        <module>dental-server</module>
        <module>dental-client</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring.boot.version>3.5.16</spring.boot.version>
        <springdoc.version>2.8.17</springdoc.version>
        <jacoco.version>0.8.12</jacoco.version>
        <surefire.version>3.2.5</surefire.version>
        <failsafe.version>3.2.5</failsafe.version>
        <!-- Every plugin version is pinned. An unpinned plugin resolves to
             "whatever is newest today", which is how a build that worked in
             March fails in June on somebody else's machine. -->
        <compiler.plugin.version>3.13.0</compiler.plugin.version>

        <!--
          JaCoCo publishes its agent switches into this property rather than
          into the default "argLine". Surefire then composes its own argLine
          from it. The empty default matters: it means `mvn test -Djacoco.skip=true`
          still runs, instead of failing on an unresolved @{argLine} - a trap
          that catches anyone trying to run the tests quickly.
        -->
        <jacocoArgLine></jacocoArgLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Import the Spring Boot BOM instead of inheriting from
                 spring-boot-starter-parent, so that the non-Spring modules
                 (common, client) stay lightweight but still get managed
                 versions for anything they do share (e.g. Jackson). -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>lk.icbt.cis6003</groupId>
                <artifactId>dental-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- Unit tests: *Test.java -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!-- EnableDynamicAgentLoading lets Mockito attach its
                             inline mock maker on JDK 21+ without the warning
                             that it will stop working in a future JDK. -->
                        <argLine>@{jacocoArgLine} -XX:+EnableDynamicAgentLoading</argLine>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- Integration tests: *IT.java -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe.version}</version>
                    <configuration>
                        <argLine>@{jacocoArgLine} -XX:+EnableDynamicAgentLoading</argLine>
                        <!--
                          Failsafe normally puts the PACKAGED artifact on the
                          classpath, because integration tests usually test what
                          was built. For a Spring Boot application that artifact
                          is a fat jar whose classes live under BOOT-INF/classes
                          and are not loadable as an ordinary classpath entry,
                          which shows up as a NoClassDefFoundError during test
                          discovery. Pointing at target/classes restores the
                          normal layout.
                        -->
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Code coverage evidence for Task C -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                            <configuration>
                                <propertyName>jacocoArgLine</propertyName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>coverage-report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
