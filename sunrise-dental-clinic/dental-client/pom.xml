<?xml version="1.0" encoding="UTF-8"?>
<!--
  dental-client - the menu-driven desktop application.

  Deliberately has NO dependency on dental-server and no Spring, JPA or JDBC on
  its classpath. Its only link to the system is HTTP + JSON against the
  published REST web services, which is what makes the solution genuinely
  distributed rather than a single process pretending to be two.

  The HTTP call is made with java.net.http.HttpClient from the JDK itself, so
  the client stays small enough to hand to a receptionist as a single
  executable jar.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lk.icbt.cis6003</groupId>
        <artifactId>sunrise-dental-clinic</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dental-client</artifactId>
    <name>Sunrise Dental :: Desktop Client</name>

    <dependencies>
        <dependency>
            <groupId>lk.icbt.cis6003</groupId>
            <artifactId>dental-common</artifactId>
        </dependency>

        <!-- JSON binding only - no web framework on the client -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>sunrise-dental-client</finalName>
        <plugins>
            <!-- Produces an executable fat jar: java -jar sunrise-dental-client.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>lk.icbt.cis6003.dental.client.DentalClientApplication</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
