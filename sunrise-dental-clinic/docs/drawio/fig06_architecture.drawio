        <mxCell id="n4" value="PRESENTATION TIER" style="rounded=1;fillColor=#FDF0E4;strokeColor=#9FB0BD;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.0" y="100.0" width="1190.0" height="175.0" as="geometry"/></mxCell>
        <mxCell id="n5" value="BUSINESS TIER" style="rounded=1;fillColor=#E8F4F5;strokeColor=#9FB0BD;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.0" y="295.0" width="1190.0" height="260.0" as="geometry"/></mxCell>
        <mxCell id="n6" value="DATA TIER" style="rounded=1;fillColor=#EEF3EA;strokeColor=#9FB0BD;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.0" y="585.0" width="1190.0" height="230.0" as="geometry"/></mxCell>
        <mxCell id="n7" value="Web Browser Client&#10;&#10;Thymeleaf pages, hand-written CSS.&#10;No CDN, so it works offline." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=12;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130.0" y="140.0" width="340.0" height="115.0" as="geometry"/></mxCell>
        <mxCell id="n8" value="Menu-Driven Desktop Client&#10;&#10;Java Swing in its own JVM.&#10;Command pattern behind the menu." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=12;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490.0" y="140.0" width="340.0" height="115.0" as="geometry"/></mxCell>
        <mxCell id="n9" value="Any Other Client&#10;&#10;Swagger UI, curl, a mobile app -&#10;the same versioned REST contract." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=12;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="850.0" y="140.0" width="340.0" height="115.0" as="geometry"/></mxCell>
        <mxCell id="e10" value="HTTP session + CSRF" style="edgeStyle=none;rounded=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;strokeWidth=2;strokeColor=#1A2733;html=1;edgeStyle=none;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#B3261E;fontColor=#B3261E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300.0" y="255.0" as="sourcePoint"/><mxPoint x="300.0" y="305.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e11" value="HTTP + JSON only" style="edgeStyle=none;rounded=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;strokeWidth=2;strokeColor=#1A2733;html=1;edgeStyle=none;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#B3261E;fontColor=#B3261E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="255.0" as="sourcePoint"/><mxPoint x="660.0" y="305.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e12" value="HTTP Basic + JSON" style="edgeStyle=none;rounded=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;strokeWidth=2;strokeColor=#1A2733;html=1;edgeStyle=none;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#B3261E;fontColor=#B3261E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020.0" y="255.0" as="sourcePoint"/><mxPoint x="1020.0" y="305.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n13" value="Spring Boot server   -   dental-server   -   one deployable jar" style="rounded=1;fillColor=#D3E9EB;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=14;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130.0" y="307.0" width="1060.0" height="58.0" as="geometry"/></mxCell>
        <mxCell id="n14" value="Web Controllers&#10;&#10;Appointment-, Billing-, Patient-, Report-&#10;WebController. Return HTML pages and redirect to /login when nobody is signed in." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130.0" y="375.0" width="200.0" height="165.0" as="geometry"/></mxCell>
        <mxCell id="n15" value="REST Controllers&#10;&#10;/api/v1/... One response envelope and one error code per failure. Return JSON 401, never an HTML login page." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="344.0" y="375.0" width="200.0" height="165.0" as="geometry"/></mxCell>
        <mxCell id="n16" value="Security&#10;&#10;Two filter chains. BCrypt. Three roles. Session + remember-me. CSRF. Lock-out after five tries. Every attempt audited." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="558.0" y="375.0" width="200.0" height="165.0" as="geometry"/></mxCell>
        <mxCell id="n17" value="Services + Facade&#10;&#10;AppointmentService, BillingService, ReportService, PatientService, ClinicFacade. @Transactional lives here." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="772.0" y="375.0" width="200.0" height="165.0" as="geometry"/></mxCell>
        <mxCell id="n18" value="Design Patterns&#10;&#10;Strategy, Template Method, Factory, Chain of Responsibility, Observer, Adapter, Facade, Builder, Command, Singleton, DAO, DTO, MVC." style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="986.0" y="375.0" width="200.0" height="165.0" as="geometry"/></mxCell>
        <mxCell id="e19" value="JPA / Hibernate + JDBC  (ddl-auto=validate)" style="edgeStyle=none;rounded=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;strokeWidth=2;strokeColor=#1A2733;html=1;edgeStyle=none;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#B3261E;fontColor=#B3261E;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="540.0" as="sourcePoint"/><mxPoint x="660.0" y="585.0" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n20" value="Repositories + DAO&#10;&#10;Spring Data JPA interfaces, plus ReportingDao for native SQL" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130.0" y="600.0" width="330.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="n21" value="Flyway migrations&#10;&#10;V1 schema, V2 reference data, V3 views + functions, V4 triggers" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490.0" y="600.0" width="340.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="n22" value="H2 (default) / MySQL 8&#10;&#10;The same Java against two engines, chosen by a profile" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1A2733;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="860.0" y="600.0" width="330.0" height="80.0" as="geometry"/></mxCell>
        <mxCell id="n23" value="Work the database is trusted to do for itself&#10;9 tables with FK and CHECK constraints   |   uk_appointment_slot (dentist_id, slot_lock)   |   5 views   |   2 functions (FN_INVOICE_TOTAL, FN_AGEING_BUCKET)   |   2 procedures   |   4 triggers" style="rounded=1;fillColor=#F5F9F2;strokeColor=#8AA382;strokeWidth=2;arcSize=8;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="130.0" y="695.0" width="1060.0" height="105.0" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
