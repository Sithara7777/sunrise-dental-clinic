        <mxCell id="n2" value="Figure 6 - Three-Tier Architecture and Deployment" style="text;fillColor=none;strokeColor=none;fontColor=#1A2733;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=21;verticalAlign=middle;align=center;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200.0" y="20.0" width="820.0" height="40.0" as="geometry"/></mxCell>
