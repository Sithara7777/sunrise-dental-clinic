        <mxCell id="e106" value="is for" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;strokeWidth=2;strokeColor=#1A2733;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="n25" target="n34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e107" value="billed by  1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;strokeWidth=2;strokeColor=#1A2733;html=1;edgeStyle=none;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;" edge="1" parent="1" source="n34" target="n68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e108" value="consists of - ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;strokeWidth=2;strokeColor=#1A2733;html=1;edgeStyle=none;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#B3261E;fontColor=#B3261E;" edge="1" parent="1" source="n68" target="n83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n109" value="Key&#10;PK  primary key&#10;FK  foreign key&#10;UK  unique business identifier&#10;|—&lt;  one to many" style="shape=note;size=18;fillColor=#FFF9E0;strokeColor=#C8B26B;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=left;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.0" y="680.0" width="270.0" height="130.0" as="geometry"/></mxCell>
        <mxCell id="n110" value="The constraint that matters most: uk_appointment_slot (dentist_id, slot_lock). slot_lock holds &quot;date|time&quot; while a visit occupies the chair and NULL once cancelled - and NULLs never clash in SQL." style="shape=note;size=18;fillColor=#FFF9E0;strokeColor=#C8B26B;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=left;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="330.0" y="695.0" width="300.0" height="115.0" as="geometry"/></mxCell>
        <mxCell id="n111" value="Also part of the schema, but not tables&#10;&#10;Views: v_daily_schedule, v_revenue_daily, v_dentist_workload, v_treatment_popularity, v_outstanding_invoice&#10;&#10;Functions: FN_INVOICE_TOTAL, FN_AGEING_BUCKET&#10;&#10;Procedures: SP_SETTLE_INVOICE, SP_DAILY_CLOSING_SUMMARY (MySQL)&#10;&#10;Triggers: audit an appointment on insert and update, audit every payment, and on MySQL refuse any booking outside the dentist&apos;s working hours.&#10;&#10;app_user.linked_dentist_code matches dentist.dentist_code but is deliberately not a foreign key." style="shape=note;size=18;fillColor=#FFF9E0;strokeColor=#C8B26B;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=11;verticalAlign=top;align=left;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="660.0" y="510.0" width="550.0" height="300.0" as="geometry"/></mxCell>
      </root>
